<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="horizontal"
    android:gravity="center_vertical"

    android:padding="12dp"
    android:layout_marginTop="7dp"

    android:background="@drawable/bg_dashboard_card">

    <!-- Ingredient thumbnail -->

    <FrameLayout
        android:id="@+id/thumbContainer"

        android:layout_width="90dp"
        android:layout_height="90dp"

        android:background="#DCEAD6">

        <TextView
            android:id="@+id/tvThumbEmoji"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center"

            android:text="🥬"
            android:textSize="38sp" />

        <View
            android:id="@+id/viewThumbBar"

            android:layout_width="match_parent"
            android:layout_height="4dp"

            android:layout_gravity="bottom"

            android:background="#2E7D32" />

    </FrameLayout>


    <!-- Ingredient information -->

    <LinearLayout

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1"

        android:orientation="vertical"

        android:paddingStart="14dp"
        android:paddingEnd="2dp">

        <!-- Name + Status -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvName"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Fresh Spinach"

                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"

                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvStatus"

                android:layout_width="wrap_content"
                android:layout_height="32dp"

                android:gravity="center"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"

                android:text="In Stock"

                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Quantity -->

        <TextView
            android:id="@+id/tvQuantity"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="200 Gram"

            android:textColor="#53624F"
            android:textSize="16sp"

            android:layout_marginTop="2dp" />


        <!-- Expiration -->

        <TextView
            android:id="@+id/tvExpiry"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Fresh (10 days)"

            android:textSize="14sp"

            android:layout_marginTop="1dp" />


        <!-- Actions -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center_vertical"

            android:layout_marginTop="9dp">

            <!-- Quantity stepper -->

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="34dp"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:background="@drawable/bg_input">

                <TextView
                    android:id="@+id/btnMinus"

                    android:layout_width="36dp"
                    android:layout_height="34dp"

                    android:gravity="center"

                    android:text="−"

                    android:textSize="19sp"
                    android:textStyle="bold"

                    android:textColor="#526052"

                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvStepperQty"

                    android:layout_width="wrap_content"
                    android:layout_height="34dp"

                    android:minWidth="55dp"

                    android:gravity="center"

                    android:text="1 Pack"

                    android:textSize="13sp"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/btnPlus"

                    android:layout_width="36dp"
                    android:layout_height="34dp"

                    android:gravity="center"

                    android:text="+"

                    android:textSize="19sp"
                    android:textStyle="bold"

                    android:textColor="#526052"

                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- Edit -->

            <TextView
                android:id="@+id/btnEdit"

                android:layout_width="wrap_content"
                android:layout_height="36dp"

                android:layout_marginStart="12dp"

                android:gravity="center"

                android:text="✎  Edit"

                android:textColor="#526052"
                android:textSize="14sp"

                android:clickable="true"
                android:focusable="true" />


            <!-- Delete -->

            <TextView
                android:id="@+id/btnDelete"

                android:layout_width="wrap_content"
                android:layout_height="36dp"

                android:layout_marginStart="7dp"

                android:gravity="center"

                android:text="▣  Delete"

                android:textColor="#C62828"
                android:textSize="14sp"

                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>