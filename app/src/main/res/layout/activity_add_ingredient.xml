<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF9F4">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Pantry"
                android:textColor="#171717"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage the ingredients you have"
                android:textColor="#777777"
                android:textSize="13sp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="28dp" />

            <!-- Ingredient Name -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredient Name"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etIngredientName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="text"
                android:hint="e.g. Milk"
                android:padding="14dp"
                android:singleLine="true"
                android:background="@drawable/bg_input" />

            <!-- Quantity -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. 2"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:singleLine="true"
                android:background="@drawable/bg_input" />

            <!-- Unit -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unit of Measurement"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp" />

            <Spinner
                android:id="@+id/spinnerUnit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input" />

            <!-- Category -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input" />

            <!-- Expiry -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expiration Date"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp" />

            <TextView
                android:id="@+id/tvExpiryDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Select expiration date"
                android:textColor="#777777"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:focusable="true" />

            <!-- Save -->

            <Button
                android:id="@+id/btnSaveIngredient"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="28dp"
                android:text="Save Ingredient"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_button" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/navHomeContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/unfocus_home"
                android:contentDescription="Home" />

            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#777777"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- PANTRY -->

        <LinearLayout
            android:id="@+id/navPantryContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navPantryIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/focus_pantry"
                android:contentDescription="Pantry" />

            <TextView
                android:id="@+id/navPantryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pantry"
                android:textColor="#287D2F"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- RECIPE -->

        <LinearLayout
            android:id="@+id/navRecipeContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navRecipeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/unfocus_recipe"
                android:contentDescription="Recipe" />

            <TextView
                android:id="@+id/navRecipeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recipe"
                android:textColor="#777777"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>